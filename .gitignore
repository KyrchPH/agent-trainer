# Dependencies
node_modules
.npm
.pnpm-store
.yarn

# Build outputs
dist
dist-tsbuildinfo
build
*.tsbuildinfo

# Environment variables
# Default: anything starting with .env is ignored (covers .env, .env.local,
# .env.development.local, .env.production.local, etc.).
.env
.env.*
# Exceptions: templates and the public production build config CAN be committed.
# .env.local intentionally stays ignored - it's for per-developer overrides.
!.env.example
!.env.sample
!.env.template
!.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Test / coverage
coverage
.nyc_output

# Project-local context (not committed)
Agent.md
